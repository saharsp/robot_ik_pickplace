<?xml version="1.0"?>
<!--
  six_axis_arm.urdf

  Simple 6-DOF revolute arm whose joint origins are derived directly from
  the Denavit-Hartenberg table in robot_ik_pickplace/kinematics.py
  (DEFAULT_DH_TABLE), using the standard DH-to-URDF conversion:

    - Every joint's rotation axis is "0 0 1" (z), matching the DH
      convention where theta is always a rotation about z.
    - Each joint's fixed origin (xyz, rpy) encodes the PREVIOUS row's
      (d, a, alpha): xyz = (a, 0, d), rpy = (alpha, 0, 0).
    - The final (d6, a6, alpha6) offset, which has no trailing joint
      variable, becomes a fixed joint from link6 to tool0.

  This keeps the visualized robot geometrically consistent with the
  from-scratch FK/IK math -- if you change DEFAULT_DH_TABLE, update the
  matching numbers here (or, as a follow-up project, write a small script
  that generates this URDF directly from the DH table so they can never
  drift apart).

  Link visuals are simple cylinders approximating each arm segment; swap
  in real meshes (or a real robot's URDF, e.g. a UR5) once this is working.
-->
<robot name="six_axis_arm">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.06"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- joint1: theta1 about z, no leading offset -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link1">
    <!-- carries the vertical riser segment (d1 = 0.15) to link2 -->
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.15"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- joint2: applies row1 offset (d1=0.15, a1=0, alpha1=pi/2), then theta2 -->
  <joint name="joint_2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.15" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link2">
    <!-- carries the upper-arm segment (a2 = 0.50) to link3, along local x -->
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.035" length="0.50"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- joint3: applies row2 offset (d2=0, a2=0.50, alpha2=0), then theta3 -->
  <joint name="joint_3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.50 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link3">
    <!-- carries the forearm segment (a3 = 0.40) to link4, along local x -->
    <visual>
      <origin xyz="0.20 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.03" length="0.40"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- joint4: applies row3 offset (d3=0, a3=0.40, alpha3=0), then theta4 -->
  <joint name="joint_4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.40 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link4">
    <!-- carries the first wrist segment (d4 = 0.10) to link5 -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.10"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- joint5: applies row4 offset (d4=0.10, a4=0, alpha4=pi/2), then theta5 -->
  <joint name="joint_5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.10" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link5">
    <!-- carries the second wrist segment (d5 = 0.10) to link6 -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- joint6: applies row5 offset (d5=0.10, a5=0, alpha5=-pi/2), then theta6 -->
  <joint name="joint_6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.10" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2.0"/>
  </joint>

  <link name="link6">
    <!-- flange segment (d6 = 0.10) to the fixed tool0 frame -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.10"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- fixed: row6 offset (d6=0.10, a6=0, alpha6=0), no trailing joint variable -->
  <joint name="tool0_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>

</robot>
